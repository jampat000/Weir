<Project>
  <!-- Build rules from ADR-0017: nullable warnings are errors, all warnings are errors, latest analyzers. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: public members without XML docs. Docs are written where they explain a decision, not everywhere. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <!-- Symbols inside the assemblies, so a single-file publish is one file. -->
    <DebugType>embedded</DebugType>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Weir has no localized UI text of its own (the web app's strings are hard-coded English;
      the tray's WinForms dialogs are hard-coded English too — grep finds no .resx anywhere in the
      repo), so the only thing this drops from a self-contained publish is the framework's own
      translated exception/diagnostic strings for cultures other than English, which nothing in Weir
      shows to a user. Restricting to "en" keeps that language's resources (the neutral fallback
      Weir would use anyway) and removes the ~30 other satellite-resource folders a self-contained
      win-x64 publish otherwise carries.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Company>Weir</Company>
    <Product>Weir</Product>
    <Copyright>Weir contributors</Copyright>
  </PropertyGroup>

  <!--
    One version for the whole product. The server, the Windows package (packaging/windows/build-velopack.ps1),
    the Docker image and the release workflow all read WeirVersion from this line; apps/web/package.json
    carries the same number, and the release workflow refuses a tag that does not match both.
  -->
  <PropertyGroup>
    <WeirVersion>3.2.10</WeirVersion>
    <Version>$(WeirVersion)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
</Project>
