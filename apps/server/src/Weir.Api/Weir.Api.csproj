<Project Sdk="Microsoft.NET.Sdk">
  <!-- HTTP endpoints and the HTTP behaviour the web app relies on (headers, SPA hosting). -->
  <PropertyGroup>
    <RootNamespace>Weir.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Weir.Core\Weir.Core.csproj" />
    <ProjectReference Include="..\Weir.Infrastructure\Weir.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Weir.Api.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The committed reference document (apps/web/openapi/weir-openapi.json, kept current by `npm run
      api:types:check` in apps/web). WeirOpenApiDocument.cs prunes it to the operations the .NET server
      actually maps (RouteTable), so /openapi.json always reuses the committed document's schemas verbatim
      for everything it serves, with no separate copy to fall out of sync. See ADR-0017 and
      apps/server/README.md ("Until the switch (#523), apps/backend is the reference").
    -->
    <EmbeddedResource Include="..\..\..\web\openapi\weir-openapi.json" LogicalName="Weir.Api.OpenApi.committed-openapi.json" Link="OpenApi\committed-openapi.json" />
  </ItemGroup>
</Project>
