<Project Sdk="Microsoft.NET.Sdk">

  <!-- Target framework, analyzers and warnings as errors come from ../Directory.Build.props. -->
  <PropertyGroup>
    <!-- The Windows subsystem: Windows never gives this program a console, so no terminal window can open for it (#821). -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>false</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <Description>Test-only stand-in for WeirServer.exe</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tray's own stop request, so the stand-in listens on exactly the event the tray sets. -->
    <Compile Include="..\Weir.Tray\ServerStopRequest.cs" Link="ServerStopRequest.cs" />
  </ItemGroup>

</Project>
