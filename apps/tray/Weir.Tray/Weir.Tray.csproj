<Project Sdk="Microsoft.NET.Sdk">

  <!-- Target framework, analyzers, warnings as errors and the version come from ../Directory.Build.props. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\..\..\packaging\windows\assets\weir-tray-icon.ico</ApplicationIcon>
    <AssemblyName>Weir</AssemblyName>
    <RootNamespace>Weir.Tray</RootNamespace>
    <Description>Weir desktop tray host</Description>
    <!-- The tray only ships as win-x64 (packaging/windows/build-velopack.ps1), so its lock file covers that
         runtime too and a package build restores exactly what CI locked. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\packaging\windows\assets\weir-tray-icon.ico" Link="weir-tray-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests reach the tray's internal types (its own on-disk state and helpers) here rather than by
         widening them. -->
    <InternalsVisibleTo Include="Weir.Tray.Tests" />
  </ItemGroup>

</Project>
